PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pm_tool

# Google OAuth Client ID (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Optional: only allow logins from your company Google Workspace domain (e.g. virtualspheretechnologies.in)
# Leave empty to allow any Google account.
ALLOWED_DOMAIN=

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Google Calendar (meeting scheduling) ----
# OAuth client secret (same OAuth client as login). Add the Calendar API in Google Cloud Console.
GOOGLE_CLIENT_SECRET=
# Key used to encrypt stored Google refresh tokens (long random string). Falls back to JWT_SECRET.
TOKEN_ENC_KEY=

# ---- Huddles (WebRTC) ----
# STUN works on most networks. For strict office firewalls add a TURN server (e.g. coturn).
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Max people in one huddle (peer-to-peer mesh; keep <= 8)
HUDDLE_MAX=8

# ---- Meeting scheduling: office hours used to suggest clear time slots ----
WORK_START=10:00
WORK_END=19:30
# 0=Sun 1=Mon … 6=Sat
WORK_DAYS=1,2,3,4,5,6

# ---- LOCAL TEST MODE (never on a public server) ----
# DEV_LOGIN=true       # sign in as a test user without Google
# CALENDAR_MODE=fake   # simulated Google Calendar
